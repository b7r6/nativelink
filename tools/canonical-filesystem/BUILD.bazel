load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

rust_library(
    name = "nativelink-canonical-filesystem",
    srcs = [
        "src/capability.rs",
        "src/journal.rs",
        "src/lib.rs",
        "src/namespace.rs",
        "src/worker.rs",
    ],
    tags = ["manual"],
    target_compatible_with = ["@platforms//os:linux"],
    visibility = ["//visibility:public"],
    deps = [
        "//tools/canonical-config:nativelink-canonical-config",
        "@crates//:rustix-1.1.2",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:sha2",
    ],
)

rust_library(
    name = "nativelink-canonical-filesystem-redb",
    srcs = [
        "src/capability.rs",
        "src/journal.rs",
        "src/lib.rs",
        "src/namespace.rs",
        "src/worker.rs",
    ],
    crate_features = ["redb"],
    crate_name = "nativelink_canonical_filesystem",
    tags = ["manual"],
    target_compatible_with = ["@platforms//os:linux"],
    visibility = ["//visibility:public"],
    deps = [
        "//tools/canonical-config:nativelink-canonical-config",
        "@crates//:redb",
        "@crates//:rustix-1.1.2",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:sha2",
    ],
)

rust_test(
    name = "journal_test",
    compile_data = [
        "fixtures/namespace-v1.hex",
        "src/capability_tests.rs",
        "src/journal_tests.rs",
        "src/namespace_tests.rs",
        "src/tests.rs",
        "src/worker_tests.rs",
        "//tools/canonical-config:fixtures/canonical.json",
    ],
    crate = ":nativelink-canonical-filesystem-redb",
    crate_features = ["redb"],
    tags = ["manual"],
    target_compatible_with = ["@platforms//os:linux"],
)

# Cross-crate constructor/cancellation coverage, intentionally Bazel only.
rust_test(
