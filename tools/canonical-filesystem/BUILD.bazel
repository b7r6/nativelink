    tags = ["manual"],
    target_compatible_with = ["@platforms//os:linux"],
    deps = [
        ":nativelink-canonical-filesystem-redb",
        "//nativelink-scheduler",
        "//nativelink-util",
        "//tools/canonical-config:nativelink-canonical-config",
        "@crates//:openraft",
        "@crates//:redb",
        "@crates//:rustix-1.1.2",
        "@crates//:tokio",
        "@crates//:tracing",
        "@crates//:tracing-test",
    ],
)

rust_test(
    name = "ownership_test",
