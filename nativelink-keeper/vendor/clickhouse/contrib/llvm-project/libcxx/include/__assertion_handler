#ifndef _LIBCPP___ASSERTION_HANDLER
#define _LIBCPP___ASSERTION_HANDLER

#include <__config>
#include <__verbose_abort>

#if !defined(_LIBCPP_HAS_NO_PRAGMA_SYSTEM_HEADER)
#  pragma GCC system_header
#endif

#if _LIBCPP_HARDENING_MODE == _LIBCPP_HARDENING_MODE_DEBUG

#  define _LIBCPP_ASSERTION_HANDLER(message) _LIBCPP_VERBOSE_ABORT("%s", message)

#else

// TODO(hardening): use `__builtin_verbose_trap(message)` once that becomes available.
/// -------------------------------------------------
/// ClickHouse-specific patch
/// -------------------------------------------------
/// __builtin_trap has two problems:
/// 1. it raises SIGILL which is confusing in itself
/// 2. SIGILL is registered with ClickHouse's own signal handler. It prints the callstack to stderror but
///    the original error message gets lost.
///
/// Instead, call _LIBCPP_VERBOSE_ABORT which allows to implement our own error handling
///
/// #  define _LIBCPP_ASSERTION_HANDLER(message) ((void)message, __builtin_trap())
#  define _LIBCPP_ASSERTION_HANDLER(message) _LIBCPP_VERBOSE_ABORT("%s", message)
/// -------------------------------------------------

#endif // _LIBCPP_HARDENING_MODE == _LIBCPP_HARDENING_MODE_DEBUG

#endif // _LIBCPP___ASSERTION_HANDLER
